# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/patient_data
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=patient_data
DB_PORT=5432

# Security
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Bóc tách bệnh án (OCR ảnh/PDF scan & đọc phiếu digital) ---
# Để trống OPENAI_API_KEY thì hệ thống tự chạy chế độ giả lập (stub): luồng vẫn
# đi trọn vẹn nhưng dữ liệu là giả, không gọi ra ngoài và không tốn tiền.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# openai | stub
OCR_PROVIDER=openai
OCR_MODEL=gpt-4o
DOC_PARSER_PROVIDER=openai
DOC_PARSER_MODEL=gpt-4o-mini

EXTRACTION_MAX_PAGES=10
EXTRACTION_TIMEOUT_SECONDS=180
EXTRACTION_MAX_FILE_MB=20
EXTRACTION_PDF_DPI=200

# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Default test account (auto-seeded on startup)
DEFAULT_USER_EMAIL=doctor@example.com
DEFAULT_USER_PASSWORD=password123
