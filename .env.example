# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/patient_data
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=patient_data
DB_PORT=5432

# Security
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI (optional - only needed for real OCR)
OPENAI_API_KEY=

# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Default test account (auto-seeded on startup)
DEFAULT_USER_EMAIL=doctor@example.com
DEFAULT_USER_PASSWORD=password123
