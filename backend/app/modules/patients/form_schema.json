{
  "version": "2.0",
  "description": "Định nghĩa form bệnh án nghiên cứu theo template F20 (Tâm thần phân liệt) và F32 (Trầm cảm). Node nào không có 'applies_to' thì áp dụng cho mọi loại bệnh.",
  "diseases": [
    {
      "code": "f20",
      "label": "Tâm thần phân liệt",
      "aliases": ["schizophrenia", "tâm thần phân liệt", "phân liệt", "phan liet", "ttpl", "f20"]
    },
    {
      "code": "f32",
      "label": "Trầm cảm",
      "aliases": ["depression", "trầm cảm", "tram cam", "f32"]
    },
    {
      "code": "normal",
      "label": "Bình thường",
      "aliases": ["normal", "bình thường", "binh thuong"]
    }
  ],
  "exam_table_columns": [
    { "key": "exam_info.exam_date", "label": "Ngày khám", "kind": "date" },
    { "key": "general", "label": "Toàn thân" },
    { "key": "cardiovascular", "label": "Tuần hoàn" },
    { "key": "respiratory", "label": "Hô hấp" },
    { "key": "digestive", "label": "Tiêu hóa" },
    { "key": "urinary", "label": "Tiết niệu" },
    { "key": "neurological", "label": "Khám thần kinh" },
    { "key": "other_body_parts", "label": "Bộ phận khác" },
    { "key": "mental_exam", "label": "Khám tâm thần" },
    { "key": "general_lab", "label": "Cận lâm sàng chung" },
    { "key": "other_lab", "label": "Cận lâm sàng khác" },
    { "key": "diagnosis", "label": "Chẩn đoán" },
    { "key": "treatment", "label": "Điều trị" }
  ],
  "blocks": [
    {
      "id": "administrative",
      "label": "THỦ TỤC HÀNH CHÍNH",
      "part": "PHẦN 1",
      "type": "block",
      "children": [
        {
          "id": "patient_code",
          "label": "Mã hồ sơ",
          "type": "text",
          "readonly": true,
          "source": "patient.patient_code"
        },
        {
          "id": "full_name",
          "label": "Họ và tên",
          "type": "text",
          "required": true,
          "source": "patient.full_name"
        },
        { "id": "age", "label": "Tuổi", "type": "number", "unit": "tuổi", "source": "patient.age" },
        {
          "id": "gender",
          "label": "Giới",
          "type": "radio",
          "source": "patient.metadata.gender",
          "options": [
            { "value": "male", "label": "Nam" },
            { "value": "female", "label": "Nữ" }
          ]
        },
        {
          "id": "hometown",
          "label": "Quê quán (đơn vị)",
          "type": "text",
          "source": "patient.hometown"
        },
        {
          "id": "admission_date",
          "label": "Ngày vào viện",
          "type": "date",
          "source": "patient.metadata.admission_date"
        },
        {
          "id": "ethnicity",
          "label": "Dân tộc",
          "type": "text",
          "source": "patient.metadata.ethnicity"
        },
        {
          "id": "education_level",
          "label": "Trình độ học vấn",
          "type": "radio",
          "source": "patient.metadata.education_level",
          "options": [
            { "value": "illiterate", "label": "Mù chữ" },
            { "value": "primary", "label": "Tiểu học" },
            { "value": "secondary", "label": "THCS" },
            { "value": "high_school", "label": "THPT" },
            { "value": "higher", "label": "THCN, CĐ, ĐH, SĐH" }
          ]
        },
        {
          "id": "occupation",
          "label": "Nghề nghiệp",
          "type": "radio",
          "source": "patient.metadata.occupation",
          "options": [
            { "value": "farmer", "label": "Nông dân" },
            { "value": "worker", "label": "Công nhân" },
            { "value": "officer", "label": "Viên chức" },
            { "value": "student", "label": "HSSV" },
            { "value": "soldier", "label": "Bộ Đội" },
            { "value": "freelance", "label": "Tự do" }
          ]
        },
        {
          "id": "residence",
          "label": "Nơi thường trú",
          "type": "radio",
          "source": "patient.metadata.residence",
          "options": [
            { "value": "urban", "label": "Thành thị" },
            { "value": "rural", "label": "Nông thôn" },
            { "value": "mountain", "label": "Miền núi" },
            { "value": "coastal", "label": "Ven biển" }
          ]
        },
        {
          "id": "marital_status",
          "label": "Tình trạng hôn nhân",
          "type": "radio",
          "source": "patient.metadata.marital_status",
          "options": [
            { "value": "married", "label": "Đã kết hôn" },
            { "value": "single", "label": "Chưa kết hôn" },
            { "value": "divorced", "label": "Ly hôn / ly thân" },
            { "value": "widowed", "label": "Góa" }
          ]
        }
      ]
    },

    {
      "id": "medical_history",
      "label": "HỎI BỆNH",
      "part": "PHẦN 2",
      "type": "block",
      "applies_to": ["f20", "f32"],
      "children": [
        {
          "id": "admission_reason",
          "label": "Lý do vào viện",
          "type": "group",
          "children": [
            {
              "id": "psychotic_symptoms",
              "label": "a. Triệu chứng loạn thần",
              "type": "checkbox_group",
              "applies_to": ["f20"],
              "options": [
                { "value": "hear_voices", "label": "Nghe có tiếng người nói trong đầu" },
                { "value": "persecuted", "label": "Cho rằng có người làm hại, theo dõi hoặc đầu độc mình" },
                { "value": "thought_broadcast", "label": "Cho rằng người khác biết hoặc chi phối suy nghĩ của mình" },
                { "value": "controlled", "label": "Tin rằng có người điều khiển hành vi của mình" },
                { "value": "other", "label": "Khác" }
              ]
            },
            {
              "id": "psychotic_symptoms_other",
              "label": "Triệu chứng loạn thần khác (cụ thể)",
              "type": "text",
              "applies_to": ["f20"],
              "show_if": { "field": "psychotic_symptoms", "includes": "other" }
            },
            {
              "id": "behavior_disorder",
              "label": "b. Rối loạn hành vi",
              "type": "checkbox_group",
              "applies_to": ["f20"],
              "options": [
                { "value": "bizarre", "label": "Có hành vi kỳ dị, khó hiểu" },
                { "value": "agitated", "label": "Kích động, gây gổ hoặc phá phách" },
                { "value": "wandering", "label": "Lang thang, bỏ nhà đi" },
                { "value": "self_neglect", "label": "Giảm chăm sóc bản thân" },
                { "value": "harm_others", "label": "Có hành vi gây hại cho người khác" },
                { "value": "suicidal", "label": "Có ý tưởng hoặc hành vi tự sát" },
                { "value": "other", "label": "Khác" }
              ]
            },
            {
              "id": "behavior_disorder_other",
              "label": "Rối loạn hành vi khác (cụ thể)",
              "type": "text",
              "applies_to": ["f20"],
              "show_if": { "field": "behavior_disorder", "includes": "other" }
            },
            {
              "id": "depressive_reasons",
              "label": "Lý do vào viện",
              "type": "checkbox_group",
              "applies_to": ["f32"],
              "options": [
                { "value": "sadness", "label": "Buồn chán bi quan quá mức" },
                { "value": "fatigue", "label": "Mệt mỏi, mất năng lượng" },
                { "value": "anhedonia", "label": "Giảm/mất hứng thú sở thích" },
                { "value": "suicidal", "label": "Ý tưởng/hành vi tự sát" },
                { "value": "food_refusal", "label": "Từ chối ăn" },
                { "value": "severe_insomnia", "label": "Mất ngủ trầm trọng" },
                { "value": "other", "label": "Khác" }
              ]
            },
            {
              "id": "depressive_reasons_other",
              "label": "Lý do khác (cụ thể)",
              "type": "text",
              "applies_to": ["f32"],
              "show_if": { "field": "depressive_reasons", "includes": "other" }
            },
            {
              "id": "description",
              "label": "Mô tả",
              "type": "textarea",
              "applies_to": ["f20"]
            }
          ]
        },
        {
          "id": "disease_history",
          "label": "Bệnh sử",
          "type": "group",
          "children": [
            {
              "id": "onset_time",
              "label": "Thời gian khởi phát",
              "type": "text",
              "applies_to": ["f20"]
            },
            {
              "id": "onset_age",
              "label": "Tuổi khởi phát",
              "type": "number",
              "unit": "tuổi",
              "applies_to": ["f32"]
            },
            {
              "id": "duration_years",
              "label": "Thời gian bị bệnh (năm)",
              "type": "number",
              "unit": "năm",
              "applies_to": ["f32"]
            },
            {
              "id": "duration_months",
              "label": "Thời gian bị bệnh (tháng)",
              "type": "number",
              "unit": "tháng"
            },
            {
              "id": "previous_diagnoses",
              "label": "Chẩn đoán những lần trước đó",
              "type": "checkbox_group",
              "options": [
                { "value": "depression", "label": "Trầm cảm" },
                { "value": "mania", "label": "Hưng cảm" },
                { "value": "schizophrenia", "label": "Tâm thần phân liệt" },
                { "value": "other", "label": "Khác" }
              ]
            },
            {
              "id": "previous_diagnoses_other",
              "label": "Chẩn đoán khác (cụ thể)",
              "type": "text",
              "show_if": { "field": "previous_diagnoses", "includes": "other" }
            },
            {
              "id": "progression",
              "label": "Tiến triển bệnh",
              "type": "radio",
              "options": [
                { "value": "continuous", "label": "Liên tục" },
                { "value": "episodic", "label": "Từng giai đoạn" }
              ]
            },
            { "id": "relapse_count", "label": "Số lần tái phát bệnh", "type": "number", "unit": "lần" },
            {
              "id": "previous_inpatient_count",
              "label": "Số lần điều trị nội trú trước đây",
              "type": "number",
              "unit": "lần"
            },
            {
              "id": "medications_before",
              "label": "Thuốc đã sử dụng trước vào viện",
              "type": "radio",
              "options": [
                { "value": "none", "label": "Không dùng" },
                { "value": "one", "label": "1 loại" },
                { "value": "two", "label": "2 loại" },
                { "value": "three_plus", "label": "≥ 3 loại" }
              ]
            },
            {
              "id": "medications_before_detail",
              "label": "Thuốc đã dùng (cụ thể)",
              "type": "textarea"
            },
            {
              "id": "maintenance_treatment",
              "label": "Tình trạng điều trị củng cố",
              "type": "radio",
              "options": [
                { "value": "regular", "label": "Đều" },
                { "value": "irregular", "label": "Không đều" },
                { "value": "none", "label": "Không điều trị" }
              ]
            },
            {
              "id": "onset_circumstances",
              "label": "Hoàn cảnh xuất hiện",
              "type": "checkbox_group",
              "options": [
                { "value": "after_stress", "label": "Sau một căng thẳng tâm lý" },
                { "value": "unknown", "label": "Không rõ" },
                { "value": "after_illness", "label": "Sau một bệnh thực thể" }
              ]
            },
            {
              "id": "onset_circumstances_detail",
              "label": "Hoàn cảnh xuất hiện (cụ thể)",
              "type": "text"
            }
          ]
        },
        {
          "id": "personal_development",
          "label": "Tiền sử — Quá trình phát triển của bản thân",
          "type": "group",
          "children": [
            {
              "id": "pregnancy",
              "label": "Thời kỳ mẹ mang thai",
              "type": "radio",
              "options": [
                { "value": "normal", "label": "Bình thường" },
                { "value": "abnormal", "label": "Bất thường" }
              ]
            },
            {
              "id": "birth_trauma",
              "label": "Sang chấn sản khoa",
              "type": "radio",
              "options": [
                { "value": "yes", "label": "Có" },
                { "value": "no", "label": "Không" }
              ]
            },
            {
              "id": "peer_relationship",
              "label": "Mối quan hệ với bạn bè",
              "type": "radio",
              "options": [
                { "value": "open", "label": "Cởi mở" },
                { "value": "withdrawn", "label": "Thu hẹp" }
              ]
            }
          ]
        },
        {
          "id": "personal_history",
          "label": "Tiền sử bản thân",
          "type": "group",
          "children": [
            {
              "id": "conditions",
              "label": "Tiền sử bản thân",
              "type": "checkbox_group",
              "options": [
                { "value": "head_trauma", "label": "Chấn thương sọ não" },
                { "value": "psych_trauma", "label": "Chấn thương tâm lý" },
                { "value": "alcohol", "label": "Lạm dụng rượu" },
                { "value": "drugs", "label": "Ma túy" },
                { "value": "other_mental", "label": "Bệnh tâm thần khác" }
              ]
            },
            {
              "id": "other_mental_detail",
              "label": "Bệnh tâm thần khác (cụ thể)",
              "type": "text",
              "show_if": { "field": "conditions", "includes": "other_mental" }
            },
            {
              "id": "somatic_disease_detail",
              "label": "Bệnh lý thực thể (cụ thể)",
              "type": "text"
            }
          ]
        },
        {
          "id": "family_history",
          "label": "Tiền sử gia đình",
          "type": "group",
          "children": [
            {
              "id": "status",
              "label": "Tiền sử gia đình",
              "type": "radio",
              "options": [
                { "value": "none", "label": "Không mắc" },
                { "value": "depression", "label": "Mắc Trầm cảm" },
                { "value": "other_mental", "label": "Mắc RLTT khác" }
              ]
            },
            {
              "id": "other_detail",
              "label": "RLTT khác (cụ thể)",
              "type": "text",
              "show_if": { "field": "status", "equals": "other_mental" }
            }
          ]
        }
      ]
    },

    {
      "id": "examination",
      "label": "KHÁM BỆNH",
      "part": "PHẦN 3 → PHẦN 7",
      "type": "block",
      "children": [
        {
          "id": "exam_info",
          "label": "Thông tin lần khám",
          "type": "group",
          "children": [
            { "id": "exam_date", "label": "Ngày khám", "type": "date", "required": true }
          ]
        },
        {
          "id": "general",
          "label": "3.1. Toàn thân",
          "type": "group",
          "table_column": "Toàn thân",
          "children": [
            { "id": "body_condition", "label": "Thể trạng", "type": "text" },
            { "id": "skin_mucosa", "label": "Da, niêm mạc", "type": "text" },
            { "id": "weight", "label": "Cân nặng", "type": "number", "unit": "kg" },
            { "id": "height", "label": "Chiều cao", "type": "number", "unit": "cm" },
            { "id": "pulse", "label": "Mạch", "type": "number", "unit": "l/p" },
            { "id": "temperature", "label": "Nhiệt độ", "type": "number", "unit": "°C" },
            { "id": "blood_pressure", "label": "Huyết áp", "type": "text", "unit": "mmHg" }
          ]
        },
        {
          "id": "cardiovascular",
          "label": "3.2. Tuần hoàn",
          "type": "group",
          "table_column": "Tuần hoàn",
          "children": [{ "id": "finding", "label": "Tuần hoàn", "type": "textarea" }]
        },
        {
          "id": "respiratory",
          "label": "3.3. Hô hấp",
          "type": "group",
          "table_column": "Hô hấp",
          "children": [{ "id": "finding", "label": "Hô hấp", "type": "textarea" }]
        },
        {
          "id": "digestive",
          "label": "3.4. Tiêu hóa",
          "type": "group",
          "table_column": "Tiêu hóa",
          "children": [{ "id": "finding", "label": "Tiêu hóa", "type": "textarea" }]
        },
        {
          "id": "urinary",
          "label": "3.5. Tiết niệu",
          "type": "group",
          "table_column": "Tiết niệu",
          "children": [{ "id": "finding", "label": "Tiết niệu", "type": "textarea" }]
        },
        {
          "id": "neurological",
          "label": "3.6. Khám thần kinh",
          "type": "group",
          "table_column": "Khám thần kinh",
          "children": [{ "id": "finding", "label": "Khám thần kinh", "type": "textarea" }]
        },
        {
          "id": "other_body_parts",
          "label": "3.7. Các bộ phận khác",
          "type": "group",
          "table_column": "Bộ phận khác",
          "children": [{ "id": "finding", "label": "Các bộ phận khác", "type": "textarea" }]
        },

        {
          "id": "mental_exam",
          "label": "3.8. KHÁM TÂM THẦN",
          "type": "group",
          "table_column": "Khám tâm thần",
          "applies_to": ["f20", "f32"],
          "children": [
            {
              "id": "general_observation",
              "label": "3.8.1. Quan sát chung",
              "type": "group",
              "children": [
                {
                  "id": "contact",
                  "label": "Tiếp xúc",
                  "type": "radio",
                  "options": [
                    { "value": "cooperative", "label": "Hợp tác" },
                    { "value": "uncooperative", "label": "Không hợp tác" },
                    { "value": "limited", "label": "Hợp tác hạn chế" }
                  ]
                },
                {
                  "id": "attitude",
                  "label": "Thái độ",
                  "type": "checkbox_group",
                  "options": [
                    { "value": "natural", "label": "Tự nhiên" },
                    { "value": "indifferent", "label": "Thờ ơ" },
                    { "value": "avoidant", "label": "Né tránh" },
                    { "value": "tense", "label": "Căng thẳng" },
                    { "value": "oppositional", "label": "Chống đối" }
                  ]
                },
                {
                  "id": "hygiene",
                  "label": "Vệ sinh, trang phục",
                  "type": "checkbox_group",
                  "options": [
                    { "value": "tidy", "label": "Gọn gàng, sạch sẽ" },
                    { "value": "untidy", "label": "Lôi thôi, bẩn thỉu" },
                    { "value": "weather_inappropriate", "label": "Không phù hợp thời tiết", "applies_to": ["f20"] },
                    { "value": "bizarre", "label": "Kỳ dị", "applies_to": ["f20"] }
                  ]
                },
                {
                  "id": "facial_expression",
                  "label": "Nét mặt",
                  "type": "checkbox_group",
                  "options": [
                    { "value": "normal", "label": "Bình thường" },
                    { "value": "sad", "label": "Buồn rầu" },
                    { "value": "anxious", "label": "Lo âu" },
                    { "value": "tense", "label": "Căng thẳng" },
                    { "value": "apathetic", "label": "Vô cảm" }
                  ]
                },
                { "id": "description", "label": "Mô tả", "type": "textarea" }
              ]
            },
            {
              "id": "consciousness",
              "label": "3.8.2. Ý thức",
              "type": "group",
              "children": [
                {
                  "id": "orientation",
                  "label": "Định hướng",
                  "type": "matrix",
                  "columns": [
                    { "value": "normal", "label": "Bình thường" },
                    { "value": "disordered", "label": "Rối loạn" }
                  ],
                  "rows": [
                    { "id": "space", "label": "Định hướng không gian" },
                    { "id": "time", "label": "Định hướng thời gian" },
                    { "id": "self", "label": "Định hướng bản thân" },
                    { "id": "surroundings", "label": "Định hướng xung quanh" }
                  ]
                },
                { "id": "description", "label": "Mô tả", "type": "textarea" }
              ]
            },
            {
              "id": "emotion",
              "label": "3.8.3. Cảm xúc – tình cảm",
              "type": "group",
              "children": [
                {
                  "id": "mood",
                  "label": "Khí sắc",
                  "type": "checkbox_group",
                  "applies_to": ["f20"],
                  "options": [
                    { "value": "normal", "label": "Bình thường" },
                    { "value": "decreased", "label": "Giảm" },
                    { "value": "increased", "label": "Tăng" },
                    { "value": "irritable", "label": "Kích thích" }
                  ]
                },
                {
                  "id": "affect",
                  "label": "Cảm xúc",
                  "type": "checkbox_group",
                  "applies_to": ["f20"],
                  "options": [
